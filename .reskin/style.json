  "layout": {
    "id": "ticker-stage",
    "name": "Ticker Stage",
    "family": "linear",
    "signature": [
      "horizontal ticker band as primary navigation and status",
      "full-width horizontal sections stacked like a broadcast",
      "oversized figures with hard rules",
      "no sidebar and no conventional top app bar",
      "content reveals in horizontal beats"
    ],
    "navigation": "A ticker strip under the wordmark; route names repeat as short labels; active route is marked by a moving underline. Keyboard arrows move the ticker.",
    "structure": [
      "wordmark + ticker strip",
      "full-bleed statement band",
      "three horizontal data beats",
      "ledger band",
      "status footer"
    ],
    "content_mapping": "Each metric becomes a horizontal beat with a huge figure and a small caption. Tables become full-width ledger bands. Forms become a single horizontal strip with inline labels.",
    "css_recipe": ".ticker{display:flex;gap:0;overflow:auto;border-block:1px solid var(--line);white-space:nowrap}.ticker a{padding:14px 22px;border-right:1px solid var(--line)}.beat{display:grid;grid-template-columns:minmax(140px,.6fr) minmax(0,2fr);gap:24px;padding:clamp(24px,4vw,56px) 0;border-bottom:1px solid var(--line)}.figure{font-size:clamp(2.4rem,6vw,6rem);line-height:.9}",
    "risks": [
      "horizontal overflow must be intentional and keyboard reachable",
      "ticker must not trap focus"
    ],
